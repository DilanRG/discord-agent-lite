# Discord
DISCORD_TOKEN=
# Optional: sync slash commands to one guild immediately while developing.
DEV_GUILD_ID=

# Character card. Supports plain JSON or chara_card_v2 JSON.
CHARACTER_FILE=characters/character.json
BOT_ACTIVITY=
# The card defines the character. Visible output is always one typed,
# single-speaker Discord message without narrated stage directions.

# This lean agent uses AI Horde for RP/chat models.
LLM_PROVIDER=horde

# AI Horde. Anonymous access uses 0000000000 but has lower priority/limits.
HORDE_API_KEY=0000000000
HORDE_BASE_URL=https://aihorde.net/api/v2
HORDE_TRUSTED_WORKERS=true
HORDE_POLL_SECONDS=2
HORDE_TIMEOUT_SECONDS=120
# Adaptive routing only: live 7B+ models with known prompt formats and capacity.
HORDE_ROUTER_METADATA_TTL_SECONDS=90
HORDE_ROUTER_STICKY_SECONDS=1800
HORDE_MIN_MODEL_PARAMETERS_BN=7
HORDE_ROUTER_MAX_SCOPES=512

PROVIDER_MAX_TOKENS=300
PROVIDER_CONTEXT_TOKENS=8192
# Background tasks can use smaller-capacity models than visible chat.
RELATIONSHIP_CONTEXT_TOKENS=4096
PROACTIVE_CONTEXT_TOKENS=4096

# Comma-separated channel IDs. These seed SQLite only when no saved row exists.
# Prefer /agent channel after the first startup.
AUTO_REPLY_CHANNELS=
PROACTIVE_CHANNELS=
BLACKLISTED_USER_IDS=
RESPOND_TO_DMS=true
AUTO_REPLY_PROBABILITY=0.10
AUTO_REPLY_QUESTION_BONUS=0.18

# Input/output and attachment bounds.
MAX_INPUT_CHARS=3500
MAX_ATTACHMENT_BYTES=5242880
MAX_ATTACHMENT_CHARS=6000
ATTACHMENT_MAX_COUNT=2
ATTACHMENT_MAX_EXTRACTED_CHARS=6000
ATTACHMENT_MAX_PIXELS=16777216
ATTACHMENT_TIMEOUT_SECONDS=60
ATTACHMENT_CONCURRENCY=1
ATTACHMENT_DOCUMENT_LOCK_PATH=/run/lock/agent-lite-attachments.lock
# Supported images go to AI Horde Alchemist for a fallible caption.
# Alchemist requires a user API key; text shared keys are not accepted there.
# The default is anonymous access; set a non-shared user API key for higher priority.
ALCHEMIST_API_KEY=0000000000
ALCHEMIST_ENABLED=true
MAX_REPLY_CHARS=1800

# Bounded lexical memory. No embeddings or local model are loaded.
DATABASE_PATH=data/agent.db
RECENT_MESSAGE_COUNT=14
RECALL_MESSAGE_COUNT=4
RECALL_CANDIDATE_COUNT=200
MAX_MESSAGES_PER_CHANNEL=600
MAX_MEMORIES_PER_USER=50
# Cross-server safety ceilings. Old conversation messages are evicted oldest-first;
# new explicit memories are rejected once the global memory ceiling is full.
MAX_TOTAL_MESSAGES=10000
MAX_TOTAL_MEMORIES=5000
MAX_MODEL_OUTCOMES=1000

# Social continuity: one global social identity per Discord user for this bot.
# Public guild observations may follow the user across guilds; DM observations are
# supplied only in DMs. The configured character filename selects a matching legacy
# identity, if needed, during the one-time v1.1 database migration.
RELATIONSHIPS_ENABLED=true
# By default, every turn the bot successfully answers becomes a relationship event
# for that author, including admitted auto-replies. Set this true to restrict social
# continuity to DMs, explicit mentions, and replies whose Discord @ toggle is on.
RELATIONSHIP_DIRECT_ONLY=false
# Reflect after this many completed pairs, or after enough meaningful events, and
# no more often than the minimum interval. Reflections use the remote provider.
RELATIONSHIP_REFLECT_EVERY=6
RELATIONSHIP_MEANINGFUL_CHARS=220
RELATIONSHIP_MEANINGFUL_EVENT_THRESHOLD=1
RELATIONSHIP_REFLECT_MIN_SECONDS=1800
RELATIONSHIP_REFLECT_MAX_EVENTS=10
# Maximum profile/journal rows inserted into a normal reply prompt.
PROFILE_CONTEXT_FACTS=8
JOURNAL_CONTEXT_ENTRIES=2
# Per-user and global write-time ceilings. New unknown relationship profiles are
# rejected when MAX_TOTAL_RELATIONSHIPS is full; established profiles keep working.
MAX_PROFILE_FACTS_PER_USER=24
MAX_JOURNAL_ENTRIES_PER_USER=20
MAX_PENDING_INTERACTIONS_PER_USER=12
MAX_TOTAL_PROFILE_FACTS=5000
MAX_TOTAL_JOURNAL_ENTRIES=3000
MAX_TOTAL_PENDING_INTERACTIONS=5000
MAX_TOTAL_RELATIONSHIPS=5000

# Abuse and cost controls.
USER_RATE_REQUESTS=3
USER_RATE_PERIOD_SECONDS=60
CHANNEL_RATE_REQUESTS=8
CHANNEL_RATE_PERIOD_SECONDS=60
COMMAND_RATE_REQUESTS=12
COMMAND_RATE_PERIOD_SECONDS=60
# Passive history ingestion in configured auto/proactive channels.
TRACKING_USER_MESSAGES=30
TRACKING_CHANNEL_MESSAGES=120
TRACKING_RATE_PERIOD_SECONDS=60
GLOBAL_CONCURRENCY=2
# Total admitted generation tasks (running plus waiting); bounds retained request state.
MAX_PENDING_REQUESTS=6

# Context-generated proactivity. Disabled until a channel is configured.
PROACTIVE_INTERVAL_SECONDS=3600
PROACTIVE_MIN_IDLE_SECONDS=43200
PROACTIVE_COOLDOWN_SECONDS=43200
PROACTIVE_DAILY_LIMIT=2
PROACTIVE_TIMEZONE=UTC

# Logging. Message bodies are not written to logs.
LOG_PATH=logs/agent.log
LOG_LEVEL=INFO
